{
  "name": "midi-of-hearts",
  "version": "0.0.25",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "tsc && vp build",
    "preview": "vp preview",
    "lint": "vp fmt && vp lint --fix --format=stylish",
    "bump": "npm version patch",
    "audit": "node scripts/lighthouse.js",
    "report": "node scripts/parse-report.js",
    "svgo": "npx svgo ./src/assets/svg/*.svg && npx svgo public/logo.svg",
    "pwa": "npx @vite-pwa/assets-generator --html --preset minimal-2023 public/logo.svg"
  },
  "devDependencies": {
    "http-server": "^14.1.1",
    "lighthouse": "^12.0.0",
    "puppeteer": "^23.0.0",
    "typescript": "~6.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vite-plugin-pwa": "^1.2.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vite-plus": "latest"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vitest": "npm:@voidzero-dev/vite-plus-test@latest"
  },
  "packageManager": "npm@11.13.0"
}
